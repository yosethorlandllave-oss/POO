<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- Login con el estilo de la ventana "Iniciar sesión" de la tienda en línea -->
<VBox prefWidth="440.0" styleClass="login-fondo" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.LoginController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="login-cabecera-web">
         <children>
            <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../img/logo-coolbox.png" />
               </image>
            </ImageView>
            <Label styleClass="login-titulo-web" text="Iniciar sesión" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="marca-sub" text="Coolbox · Juliaca" />
         </children>
      </HBox>
      <VBox spacing="10.0">
         <children>
            <Label styleClass="login-texto" text="Ingresa tu usuario y contraseña para continuar." wrapText="true" />
            <Label styleClass="login-etiqueta" text="Usuario">
               <VBox.margin>
                  <Insets top="6.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="txtUsuario" promptText="Ingresa tu usuario (ej: yazminvs)" styleClass="login-campo-web" />
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="login-etiqueta" text="Contraseña" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Hyperlink onAction="#olvideClave" styleClass="link-azul" text="¿Olvidaste tu contraseña?" />
               </children>
               <VBox.margin>
                  <Insets top="4.0" />
               </VBox.margin>
            </HBox>
            <PasswordField fx:id="txtClave" promptText="Ingresa tu contraseña" styleClass="login-campo-web" />
            <Button defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#login" styleClass="btn-ingresar" text="Ingresar">
               <graphic>
                  <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                     <image>
                        <Image url="@../img/ic-ingresar.png" />
                     </image>
                  </ImageView>
               </graphic>
               <tooltip>
                  <Tooltip text="Entrar al sistema (también con Enter)" />
               </tooltip>
               <VBox.margin>
                  <Insets top="12.0" />
               </VBox.margin>
            </Button>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Separator HBox.hgrow="ALWAYS" />
                  <Label styleClass="login-separador" text="o" />
                  <Separator HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <Button cancelButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#logout" text="Cerrar el programa">
               <graphic>
                  <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                     <image>
                        <Image url="@../img/ic-salir.png" />
                     </image>
                  </ImageView>
               </graphic>
               <tooltip>
                  <Tooltip text="Cerrar el programa (también con Esc)" />
               </tooltip>
            </Button>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="login-pie" text="¿Aún no tienes cuenta? Pídela al administrador de la tienda." wrapText="true">
               <VBox.margin>
                  <Insets top="8.0" />
               </VBox.margin>
            </Label>
         </children>
         <padding>
            <Insets bottom="22.0" left="24.0" right="24.0" top="18.0" />
         </padding>
      </VBox>
   </children>
</VBox>
